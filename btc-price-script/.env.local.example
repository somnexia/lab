# Copy to .env.local for local runs on your PC (not used in Coolify deploy).
# cp .env.local.example .env.local

API_URL=https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=eur

# Use 127.0.0.1 — NOT the Coolify internal MySQL hostname
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=btc_user
MYSQL_PASSWORD=your_local_password
MYSQL_DATABASE=btc

DISCORD_WEBHOOK=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
