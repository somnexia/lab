<mxfile host="app.diagrams.net" modified="2026-08-31T00:00:00.000Z" agent="lab-docs" version="22.1.0" type="device">
  <diagram id="erd-tenant" name="ERD — данные и tenant">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Как связаны данные и лаборатория (tenant)&#xa;LIMS · laboratory_id = граница видимости" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=18;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="560" height="50" as="geometry" />
        </mxCell>

        <!-- Note bubble -->
        <mxCell id="note" value="Простыми словами: почти все «рабочие» данные&#xa;принадлежат лаборатории. system_admin видит все;&#xa;остальные — только свою lab." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fef9c3;strokeColor=#ca8a04;fontColor=#713f12;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="20" width="320" height="80" as="geometry" />
        </mxCell>

        <!-- LABORATORY hub -->
        <mxCell id="lab" value="«Лаборатория»&#xa;laboratories&#xa;─────────────&#xa;id&#xa;lab_name&#xa;location&#xa;&#xa;★ TENANT-КОРЕНЬ" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#0f766e;strokeColor=#115e59;fontColor=#ffffff;fontStyle=1;fontSize=13;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="520" y="160" width="200" height="160" as="geometry" />
        </mxCell>

        <!-- Employee -->
        <mxCell id="emp" value="Сотрудник&#xa;employees&#xa;─────────────&#xa;id&#xa;name, surname&#xa;lab_id ← tenant&#xa;position" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#ecfdf5;strokeColor=#0f766e;fontColor=#134e4a;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="200" y="160" width="180" height="140" as="geometry" />
        </mxCell>

