        <mxCell id="inv" value="Лот / инвентарь&#xa;inventories&#xa;─────────────&#xa;id, qty, status&#xa;(lab: unit → storage)" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#334155;fontSize=12;arcSize=8;" vertex="1" parent="1">
