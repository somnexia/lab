        <!-- Legend -->
        <mxCell id="leg" value="Легенда цвета&#xa;• бирюзовый — прямая связь с laboratory_id / lab_id&#xa;• серый — lab через цепочку&#xa;• оранжевый — связка для вычисления tenant&#xa;• розовый — аудит (особый доступ)" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#334155;fontSize=11;spacingLeft=10;spacingTop=6;arcSize=6;" vertex="1" parent="1">
