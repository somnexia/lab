        <mxCell id="user" value="Учётка&#xa;users&#xa;─────────────&#xa;id, email&#xa;password (bcrypt)&#xa;role (4 роли)&#xa;employee_id" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0c4a6e;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="140" height="140" as="geometry" />
        </mxCell>

