          <mxGeometry x="800" y="140" width="180" height="120" as="geometry" />
        </mxCell>

        <!-- Storage unit -->
        <mxCell id="unit" value="Ячейка хранения&#xa;storageunits&#xa;─────────────&#xa;id&#xa;storage_id&#xa;(lab через склад)" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#334155;fontSize=12;arcSize=8;" vertex="1" parent="1">
